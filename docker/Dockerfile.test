# Dockerfile.test
ARG PYTHON_VERSION=3.10
FROM python:${PYTHON_VERSION}-slim

WORKDIR /app

# system deps (if some wheels require build)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc wget curl libffi-dev \
  && rm -rf /var/lib/apt/lists/*

# install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    ln -s /root/.local/bin/uv /usr/local/bin/uv

# copy project metadata for dependency caching
COPY pyproject.toml uv.lock /app/

# Install the versions uv.lock pins, never a fresh resolution of the constraint ranges:
# otherwise any upstream release can break an unrelated pull request. One did — fakeredis
# 2.39.0 stopped trimming `XADD MAXLEN ~`, failing test_xadd_with_maxlen on every PR.
# This layer holds the heavy dependencies and is cached independently of the source.
RUN uv export --frozen --no-hashes --no-emit-project --group dev --group tests \
      -o /tmp/requirements.txt && \
    uv pip install --system -r /tmp/requirements.txt

# copy source & tests AFTER the dependency layer, so editing them reinstalls nothing
COPY src/ /app/src/
COPY tests/ /app/tests/

# the project itself, editable; --no-deps because the lock already installed them all
RUN uv pip install --system --no-deps -e "."

# copy entrypoint script
COPY docker/entrypoint-test.sh /entrypoint-test.sh
RUN chmod +x /entrypoint-test.sh

ENTRYPOINT ["/entrypoint-test.sh"]
