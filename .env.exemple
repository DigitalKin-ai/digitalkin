DIGITALKIN_MODULE_SERVICER_SETUP_CACHE_MAX=100

# TTL in seconds for the per-setup-version cache.
DIGITALKIN_MODULE_SERVICER_SETUP_CACHE_TTL=600.0

# Max seconds to await module completion.
DIGITALKIN_MODULE_SERVICER_COMPLETION_TIMEOUT=300.0

