# Concurrency and admission limits for BaseTaskManager.

# Max tasks executing concurrently.
DIGITALKIN_TASK_MANAGER_MAX_CONCURRENT_TASKS=500

# Seconds a caller waits for an execution slot.
DIGITALKIN_TASK_MANAGER_TASK_WAIT_TIMEOUT=30.0

