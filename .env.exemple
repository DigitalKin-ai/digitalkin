# ══ CertificateSettings ══════════════════════════════════════════════ #
# Directories holding the certificates a module serves and dials with.

# Directory where the module's own server certificates are stored
CERTIFICATE_CERT_VOLUME=/certificates

# Directory where the services-provider client certificates are stored
CERTIFICATE_SERVICES_PROVIDER_CERT_VOLUME=/certificates

# ══ ClientChannelSettings ══════════════════════════════════════════════ #
# Settings for a client channel.

# Host address the client dials (the services provider)
CLIENT_CHANNEL_HOST=[::]

# Port the client dials (the services provider)
CLIENT_CHANNEL_PORT=50051

# Client/Server operation mode (sync/async)
CLIENT_CHANNEL_COMMUNICATION_MODE=async

# Path to the private key
#CLIENT_CHANNEL_CREDENTIALS__KEY_PATH=

# Path to the certificate
#CLIENT_CHANNEL_CREDENTIALS__CERT_PATH=

# Path to the root certificate
#CLIENT_CHANNEL_CREDENTIALS__ROOT_CERT_PATH=

# Security mode (secure/insecure)
CLIENT_CHANNEL_SECURITY=insecure

# Enable mutual TLS
CLIENT_CHANNEL_MTLS=false

# ══ CircuitBreakerSettings ══════════════════════════════════════════════ #
# Per-service circuit-breaker thresholds.

# Consecutive failures before the circuit opens.
CLIENT_CIRCUIT_BREAKER_FAIL_MAX=5

# Seconds the circuit stays open before a half-open probe.
CLIENT_CIRCUIT_BREAKER_RESET_TIMEOUT=30.0

# ══ ClientSettings ══════════════════════════════════════════════ #
# Settings for the DigitalKin gRPC clients.

# Retry attempts for a failed unary query.
CLIENT_MAX_RETRIES=2

# Base backoff in milliseconds for query retries.
CLIENT_BACKOFF_BASE_MS=50.0

# Default per-query deadline in seconds.
CLIENT_TIMEOUT=30.0

# ══ GrpcClientRetrySettings ══════════════════════════════════════════════ #
# gRPC service-config retry policy (channel-level).

# Max retry attempts including the original call.
CLIENT_GRPC_RETRY_MAX_ATTEMPTS=5

# Initial backoff duration (e.g. '0.1s').
CLIENT_GRPC_RETRY_INITIAL_BACKOFF=0.1s

# Maximum backoff duration (e.g. '10s').
CLIENT_GRPC_RETRY_MAX_BACKOFF=10s

# Exponential backoff multiplier.
CLIENT_GRPC_RETRY_BACKOFF_MULTIPLIER=2.0

# ══ GrpcClientSettings ══════════════════════════════════════════════ #
# gRPC tuning settings on the SDK client side.

# gRPC compression algorithm
CLIENT_GRPC_COMPRESSION=gzip

# Interval for client keepalive pings.
CLIENT_GRPC_OPTIONS_KEEPALIVE_TIME=15000

# Timeout for client keepalive pings.
CLIENT_GRPC_OPTIONS_KEEPALIVE_TIMEOUT=5000

# Minimum interval between HTTP/2 pings on the client side. Must be >= the server minimum.
CLIENT_GRPC_OPTIONS_MIN_PING_INTERVAL=10000

# Maximum message size the client can receive, in bytes.
CLIENT_GRPC_OPTIONS_MAX_RECEIVE_MESSAGE_LENGTH=104857600

# Maximum message size the client can send, in bytes.
CLIENT_GRPC_OPTIONS_MAX_SEND_MESSAGE_LENGTH=104857600

# Send keepalive pings even when there are no active RPCs. This is important for keeping connections alive through proxies and detecting dead servers.
CLIENT_GRPC_OPTIONS_KEEPALIVE_PERMIT_WITHOUT_CALLS=true

# Minimum interval between DNS re-resolutions. Critical when services restart with new IPs.
CLIENT_GRPC_OPTIONS_DNS_RESOLUTION_MS=500

# Initial reconnect backoff.
CLIENT_GRPC_OPTIONS_INITIAL_RECONNECT_MS=1000

# Maximum reconnect backoff.
CLIENT_GRPC_OPTIONS_MAX_RECONNECT_MS=10000

# Minimum reconnect backoff.
CLIENT_GRPC_OPTIONS_MIN_RECONNECT_MS=500

# Enable the gRPC C++ retry layer. Disabled by default: the per-channel service_config retry policy would otherwise stack on top of the Python-level retry loop in `exec_grpc_query`. On a cold registry channel returning UNAVAILABLE for multiple tool refs, the C++ retries caused an 8 s wall-clock gap (see monitoring/reports/sdk-8sec-gap-rootcause.md). The Python loop already covers the same retryable status codes (UNAVAILABLE, INTERNAL, DEADLINE_EXCEEDED) with a more conservative budget.
CLIENT_GRPC_OPTIONS_ENABLE_RETRIES=false

# ══ GatewayDialReconnectSettings ══════════════════════════════════════════════ #
# Server-side dial-back auto-reconnect window and backoff.

# Total time, measured from the first detected disconnect, that the gateway keeps re-dialing a dead consumer so a client that lost internet or rebooted can re-attach and resume from its cursor. Keep <= the post-EOS stream TTL.
DIGITALKIN_GATEWAY_DIAL_BACK_RECONNECT_WINDOW_S=300.0

# Base delay between re-dial attempts (full-jittered).
DIGITALKIN_GATEWAY_DIAL_BACK_RECONNECT_BACKOFF_BASE_S=3.0

# Cap on the re-dial backoff delay.
DIGITALKIN_GATEWAY_DIAL_BACK_RECONNECT_BACKOFF_MAX_S=5.0

# ══ GatewayM2MSettings ══════════════════════════════════════════════ #
# Resilience settings for in-module M2M outbound calls.

# Maximum lifetime of an outbound registry entry. A periodic sweeper drops + signals entries past their TTL even if the call's finally block never ran.
DIGITALKIN_M2M_CALL_TTL_S=300.0

# How often the TTL sweeper scans the outbound registry.
DIGITALKIN_M2M_CALL_SWEEPER_INTERVAL_S=30.0

# Per-output deadline on the queue. Trips on producers that go silent without emitting stream.end.
DIGITALKIN_M2M_CALL_TIMEOUT_S=120.0

# Process-local ceiling on in-flight outbound calls.
DIGITALKIN_M2M_CALL_MAX_CONCURRENT=200

# How long call_module blocks on the concurrency semaphore before raising.
DIGITALKIN_M2M_CALL_ACQUIRE_TIMEOUT_S=30.0

# Failures (per target host:port) before the per-target circuit breaker opens.
DIGITALKIN_M2M_CALL_BREAKER_FAIL_MAX=5

# How long a breaker stays open before a half-open probe.
DIGITALKIN_M2M_CALL_BREAKER_RESET_TIMEOUT_S=30.0

# Best-effort SendSignal(CANCEL) deadline when call_module is cancelled.
DIGITALKIN_M2M_CALL_CANCEL_SIGNAL_TIMEOUT_S=2.0

# Per-call deadline on the backend AssociateTask mint (bounded, not the 30s default).
DIGITALKIN_M2M_CALL_ASSOCIATE_TIMEOUT_S=5.0

# Per-call output queue ceiling.
DIGITALKIN_M2M_CALL_QUEUE_MAXSIZE=1024

# ══ GatewayQueueSettings ══════════════════════════════════════════════ #
# Queue and timeout settings for gateway sessions.

# TTL for the per-setup tool cache (``ModuleServicer._tool_cache_by_setup``). Entries older than this are recomputed on next lookup. The INVALIDATE_TOOLS SendSignal flushes the whole cache regardless of TTL.
DIGITALKIN_GATEWAY_QUEUE_TOOLKIT_CACHE_TTL_S=600.0

# ══ GatewaySettings ══════════════════════════════════════════════ #
# Top-level gateway configuration.

# Max concurrent gateway sessions (per instance)
DIGITALKIN_GATEWAY_MAX_STREAMS=20000

# Redis health check timeout in seconds
DIGITALKIN_GATEWAY_REDIS_HEALTH_TIMEOUT=5.0

# Idle timeout on the gateway → consumer Stream BiDi. Resets on every outbound chunk; fires only when no module output flows for this many seconds. Replaces the former absolute `dial_back_bidi_timeout_s`.
DIGITALKIN_GATEWAY_DIAL_BACK_IDLE_TIMEOUT_S=300.0

# Absolute safety ceiling on a single dial-back BiDi. Applied as the gRPC RPC deadline; guards against runaway streams even if the idle timeout keeps resetting.
DIGITALKIN_GATEWAY_DIAL_BACK_MAX_LIFETIME_S=3600.0

# Grace period after the gateway emits the terminal stream.end on the dial-back BiDi before forcibly closing the inbound side. Guards against a consumer that ignores stream.end and would otherwise hold the BiDi open until keepalive (~2 min) surfaces UNAVAILABLE.
DIGITALKIN_GATEWAY_DIAL_BACK_CLOSE_GRACE_S=2.0

# ══ GatewayStreamSettings ══════════════════════════════════════════════ #
# Redis Stream configuration for gateway data flow.

# Stream TTL (s) after EOS; >= reconnect window so a completed stream survives a reboot
DIGITALKIN_GATEWAY_STREAM_REDIS_STREAM_TTL=360

# Stream TTL in seconds before EOS
DIGITALKIN_GATEWAY_STREAM_REDIS_STREAM_INITIAL_TTL=600

# Approximate max entries before trimming
DIGITALKIN_GATEWAY_STREAM_REDIS_STREAM_MAXLEN=1000

# Cursor key TTL in seconds
DIGITALKIN_GATEWAY_STREAM_REDIS_CURSOR_TTL=360

# XREAD block timeout in milliseconds
DIGITALKIN_GATEWAY_STREAM_STREAM_READ_BLOCK_MS=50

# Max seconds a consumer's Stream read waits with no new entry before giving up. Backstops a producer that died without writing an EOS marker (module crash or cancellation) so the consumer's RPC can't hang forever.
DIGITALKIN_GATEWAY_STREAM_READ_IDLE_TIMEOUT_S=300.0

# Upper bound on a client's resume `seq` value, expressed as a multiple of ``redis_stream_maxlen``. Seq values above ``redis_stream_maxlen * from_seq_multiplier`` are rejected as obviously out-of-range.
DIGITALKIN_GATEWAY_STREAM_FROM_SEQ_MULTIPLIER=10

# ══ LoggingSettings ══════════════════════════════════════════════ #
# Logging configuration for the digitalkin logger.

# Console log level for the digitalkin logger.
DIGITALKIN_LOG_LEVEL=INFO

# Log level for the rotating file handler.
DIGITALKIN_LOG_FILE_LEVEL=DEBUG

# Directory for rotating file logs. Empty disables file logging.
#DIGITALKIN_LOG_DIR=

# Explicit log file path. Empty derives '<dir>/<logger name>.log'.
#DIGITALKIN_LOG_FILE=

# Railway platform service name. Presence flags a production environment.
#RAILWAY_SERVICE_NAME=

# ══ ModuleSettings ══════════════════════════════════════════════ #
# Per-module runtime configuration.

# Module identifier. Empty falls back to metadata module_id.
#DIGITALKIN_MODULE_ID=

# Whether service strategies run against local stubs or remote gRPC services.
SERVICE_MODE=remote

# IANA timezone for module session timestamps.
DIGITALKIN_MODULE_TIMEZONE=Europe/Paris

# Per-tool resolution deadline in seconds.
DIGITALKIN_MODULE_TOOL_RESOLVE_TIMEOUT=10.0

# Dirty-entry count that triggers a file-history flush.
DIGITALKIN_MODULE_FILE_HISTORY_FLUSH_THRESHOLD=10

# ══ ProfilingSettings ══════════════════════════════════════════════ #
# Profiling and debugging configuration.

# Profiler backend (none, pyinstrument, yappi, viztracer)
DIGITALKIN_PROFILER=none

# Directory for profile output files
DIGITALKIN_PROFILE_OUTPUT_DIR=./profiles

# Enable uvloop event loop policy
DIGITALKIN_UVLOOP=false

# Number of recent profile files to keep before rotation
DIGITALKIN_PROFILER_KEEP_N=100

# ══ QueueSettings ══════════════════════════════════════════════ #
# Defaults for asyncio queues created via QueueFactory.

# Default bounded-queue max size (0 = unbounded).
DIGITALKIN_QUEUE_MAX_SIZE=1000

# ══ RedisPoolSettings ══════════════════════════════════════════════ #
# Redis connection pool configuration.

# Redis connection URL. The gateway needs it for stream persistence.
DIGITALKIN_REDIS_URL=redis://localhost:6379/0

# Total Redis connection pool size
DIGITALKIN_REDIS_POOL_SIZE=2000

# Non-blocking pool size (0 = pool_size // 2)
DIGITALKIN_REDIS_POOL_SIZE_DEFAULT=0

# Blocking pool size for XREAD (0 = pool_size // 2)
DIGITALKIN_REDIS_POOL_SIZE_BLOCKING=0

# Max seconds to wait for a PING during health check.
DIGITALKIN_REDIS_HEALTH_CHECK_TIMEOUT=5.0

# Seconds between connection-level PINGs; 0 disables. Catches silently-dead sockets.
DIGITALKIN_REDIS_HEALTH_CHECK_INTERVAL=15

# Per-command read timeout, enforced by a client-side timer — keep it above the XREAD block time and any tolerable event-loop stall.
DIGITALKIN_REDIS_SOCKET_TIMEOUT=15.0

# Retries on the XREAD pool (idempotent). The XADD pool stays at 0 to avoid duplicate frames.
DIGITALKIN_REDIS_BLOCKING_READ_RETRIES=3

# ══ RedisSettings ══════════════════════════════════════════════ #
# Top-level Redis configuration.

# Task state TTL in seconds (1 day)
DIGITALKIN_REDIS_TASK_TTL=86400

# Idempotency claim TTL in seconds
DIGITALKIN_REDIS_IDEM_TTL=3600

# ══ RedisSignalSettings ══════════════════════════════════════════════ #
# Redis signal delivery configuration.

# Max registered signal tasks
DIGITALKIN_SIGNAL_MAX_TASKS=10000

# ══ RegistrySettings ══════════════════════════════════════════════ #
# Registry client runtime configuration.

# Per-call deadline for agent-facing registry searches (shorter than the global gRPC default).
DIGITALKIN_REGISTRY_SEARCH_TIMEOUT_S=10.0

# ══ BulkheadSettings ══════════════════════════════════════════════ #
# Per-service concurrency-limiter defaults.

# Default max concurrent calls per service.
DIGITALKIN_BULKHEAD_DEFAULT_MAX=50

# Seconds to wait for a slot before raising BulkheadFullError.
DIGITALKIN_BULKHEAD_TIMEOUT=2.0

# ══ ServerChannelSettings ══════════════════════════════════════════════ #
# Settings for a server channel.

# Host address the module server binds to
SERVER_CHANNEL_HOST=[::]

# Port the module server listens on
SERVER_CHANNEL_PORT=50055

# Client/Server operation mode (sync/async)
SERVER_CHANNEL_COMMUNICATION_MODE=async

# Path to the private key
#SERVER_CHANNEL_CREDENTIALS__KEY_PATH=

# Path to the certificate
#SERVER_CHANNEL_CREDENTIALS__CERT_PATH=

# Path to the root certificate
#SERVER_CHANNEL_CREDENTIALS__ROOT_CERT_PATH=

# Security mode (secure/insecure)
SERVER_CHANNEL_SECURITY=insecure

# Enable mutual TLS
SERVER_CHANNEL_MTLS=false

# Public hostname/IP sent to registry for discovery. Falls back to host if not set.
SERVER_CHANNEL_ADVERTISE_HOST=digitalkin-module-host

# Database URL for registry data storage
#SERVER_CHANNEL_DATABASE_URL=

# ══ GrpcServerSettings ══════════════════════════════════════════════ #
# gRPC tuning settings on the SDK side.

# gRPC compression algorithm
SERVER_GRPC_COMPRESSION=gzip

# Interval for server keepalive pings.
SERVER_GRPC_OPTIONS_KEEPALIVE_TIME=120000

# Timeout for server keepalive pings.
SERVER_GRPC_OPTIONS_KEEPALIVE_TIMEOUT=20000

# Minimum interval between HTTP/2 pings on the server side.
SERVER_GRPC_OPTIONS_MIN_PING_INTERVAL=10000

# Maximum message size the server can receive, in bytes.
SERVER_GRPC_OPTIONS_MAX_RECEIVE_MESSAGE_LENGTH=104857600

# Maximum message size the server can send, in bytes.
SERVER_GRPC_OPTIONS_MAX_SEND_MESSAGE_LENGTH=104857600

# Maximum number of pings the server allows without receiving any data. Setting to 0 allows unlimited pings, which is important for long-running streams.
SERVER_GRPC_OPTIONS_MAX_PINGS_WITHOUT_DATA=0

# Allow clients to send keepalive pings even when there are no active RPCs. This is important for keeping connections alive through proxies and detecting dead clients.
SERVER_GRPC_OPTIONS_KEEPALIVE_PERMIT_WITHOUT_CALLS=true

# ══ ServerSettings ══════════════════════════════════════════════ #
# Settings for the DigitalKin server.

# Enable health check service
SERVER_HEALTH_CHECK=true

# Enable reflection for the server
SERVER_REFLECTION=true

# Maximum number of RPCs handled in parallel by the server. Defaults to cpu_count * 200.
#SERVER_MAX_CONCURRENT_RPCS=

# Maximum number of workers for sync mode
SERVER_MAX_WORKERS=10

# Number of workers in the server thread pool. Defaults to min(4, cpu_count).
#SERVER_THREAD_POOL_WORKERS=

