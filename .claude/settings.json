{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(**/__version__.py)",
      "Edit(.bumpversion.toml)",
      "Bash(bump-my-version:*)",
      "Bash(task bump-version:*)",
      "Read(./.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets*)",
      "Read(certs/**)"
    ],
    "allow": [
      "Bash(task linter)",
      "Bash(task check)",
      "Bash(task run-tests)",
      "Bash(task build-package)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pre-commit:*)",
      "Bash(uv run mkdocs:*)",
      "Bash(rg:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)"
    ]
  },
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-edit.sh", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-python.sh", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-quality.sh",
            "timeout": 180,
            "statusMessage": "Checking lint and types on files changed this session"
          }
        ]
      }
    ]
  }
}
