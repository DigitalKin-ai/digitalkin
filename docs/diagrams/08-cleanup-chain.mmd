flowchart TD
    A["Task ends\n(completed / failed / cancelled)"] --> B["TaskExecutor._run finally"]
    A2["Cancelled before first step"] --> B2["done-callback backstop"]
    B --> C["_cleanup_task (shielded)"]
    B2 --> C
    C --> D["close_stream under write lock"]
    C --> E["Pop from tasks / tasks_sessions"]
    C --> F["session.cleanup:\ndrain queue → module.stop()\n→ context.cleanup()"]
    F --> G["stream.cancelled (if cancelled)\n+ stream.end → XADD eos + EXPIRE"]
    C --> H["Release task_slot + system_gate"]

    P["Preloaded instance, task never created"] --> Q["ModuleRunner finally:\nmodule.stop() → context.cleanup()"]

    M["ModuleServer.stop_async"] --> N["1. Stop accepting RPCs"]
    N --> O["2. job_manager.stop():\ncancel all tasks, release SharedRedisListener"]
    O --> R["3. gateway.stop()"]
    R --> S["4. Close Redis clients"]
    S --> T["5. Close channels"]
