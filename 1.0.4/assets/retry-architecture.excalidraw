    {
      "id": "layer-a-detail",
      "type": "text",
      "x": 220,
      "y": 150,
      "width": 520,
      "height": 80,
      "text": "Transparent retry inside the gRPC channel\nCodes: UNAVAILABLE, RESOURCE_EXHAUSTED, DEADLINE_EXCEEDED\nMax 5 attempts, backoff 0.1s → 10s (×2.0)\nCaller never sees retried errors",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "boundElements": [],
      "seed": 6,
