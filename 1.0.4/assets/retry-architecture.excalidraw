    {
      "id": "layer-c-detail",
      "type": "text",
      "x": 220,
      "y": 500,
      "width": 520,
      "height": 100,
      "text": "Batch-specific retry for SendSignals\nCodes: DEADLINE_EXCEEDED, UNAVAILABLE, INTERNAL\nMax 3 retries (4 total attempts)\nBackoff: 100ms → 200ms → 400ms (exponential)\nJitter: +uniform(0, delay×0.5) — prevents thundering herd",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "boundElements": [],
      "seed": 16,
      "version": 1,
      "versionNonce": 16,
      "isDeleted": false,
      "angle": 0,
      "baseline": 90,
      "containerId": null,
      "originalText": "Batch-specific retry for SendSignals\nCodes: DEADLINE_EXCEEDED, UNAVAILABLE, INTERNAL\nMax 3 retries (4 total attempts)\nBackoff: 100ms → 200ms → 400ms (exponential)\nJitter: +uniform(0, delay×0.5) — prevents thundering herd"
